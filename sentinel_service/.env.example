ADMIN_TOKEN=GENERATE_ADMIN_TOKEN
COLLECTOR_TOKEN=GENERATE_COLLECTOR_TOKEN
START_LAB=true
LOCAL_LAB_MODE=safe
UPSTREAM_URL=http://127.0.0.1:9000
GATEWAY_HOST=127.0.0.1
AUTO_SQL_REPAIR=false
KALI_IP=192.168.189.128
KALI_USER=kali
KALI_APP_PORT=9002
KALI_LAB_PATH=/home/kali/sentinel-five-agent-lab
KALI_HOST_FINGERPRINT=
LOGIN_PATH=/login
LOGIN_LIMIT=5
LOGIN_WINDOW=60
RULE_TTL=120
ENABLE_HTTP_FLOOD=false
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
ALLOWED_ORIGINS=

# SRE remediation bridge (same token must be used in sre_service/.env)
SRE_BRIDGE_ENABLED=true
SRE_BRIDGE_URL=http://127.0.0.1:8101
SRE_BRIDGE_TOKEN=GENERATE_SHARED_BRIDGE_TOKEN
SRE_BRIDGE_TIMEOUT=180
